{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stash",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "vinext/server/fetch-handler",
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"cache": {
		"enabled": true
	},
	"images": {
		"binding": "IMAGES"
	},
	"kv_namespaces": [
		{
			"binding": "STASH_KV_STORE",
			"id": "f0fc53f2483147869d275d81cffc764f"
		}
	]
}